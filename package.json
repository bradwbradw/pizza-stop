{
  "//1": "describes your app and its dependencies",
  "//2": "https://docs.npmjs.com/files/package.json",
  "//3": "updating this file will download and update your packages",
  "name": "pizza-stop",
  "version": "0.0.1",
  "description": "Visualize your crypto portfolio using a simple pizza / slice model for tracking asset values.",
  "main": "server/start.mjs",
  "type": "module",
  "watch": {
    "build-css": {
      "patterns": "scss",
      "extensions": "scss"
    },
    "start": [
      "server",
      "component",
      "module"
    ]
  },
  "scripts": {
    "test": "mocha --watch",
    "test-ui": "open-cli http://localhost:3002/test.html",
    "build-css": "node-sass --include-path scss scss/style.scss  public/style.css",
    "start": "node server/start.mjs",
    "dev": "npm-watch",
    "ui": "npx browser-sync http://localhost:5678 'public' -w"
  },
  "dependencies": {
    "@googleapis/oauth2": "^1.0.0",
    "@googleapis/sheets": "^4.0.1",
    "@openzeppelin/contract-loader": "^0.6.3",
    "@truffle/hdwallet-provider": "^2.1.15",
    "agenda": "^5.0.0",
    "body-parser": "^1.20.1",
    "discord.js": "^14.7.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "node-localstorage": "^2.2.1",
    "superagent": "^8.0.8",
    "swagger-client": "^3.18.5",
    "web3": "^4.3.0"
  },
  "engines": {
    "node": "20.x"
  },
  "repository": {
    "url": "https://glitch.com/edit/#!/hello-sqlite"
  },
  "license": "MIT",
  "keywords": [
    "node",
    "glitch",
    "express"
  ],
  "devDependencies": {
    "npm-watch": "^0.11.0",
    "proxyquire": "^2.1.3",
    "sinon": "^15.0.1"
  }
}
